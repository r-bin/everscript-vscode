    "src/core/map-editor/**",
    "src/games/evermore/docs-tab/**",
    "src/core/emulator/core/**"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn"
  },
  "ignoreBinaries": [
    "vsce"
  ]
}
