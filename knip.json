{
  "entry": [
    "src/extension.js",
    "src/shared/config.js"
  ],
  "project": [
    "src/**/*.js"
  ],
  "ignore": [
    "src/memory/webview/**",
    "src/scaling/webview/**",
    "src/rooms/webview/**",
    "src/sprites/webview/**",
    "src/rom/webview/**",
    "src/music/webview/**",
    "src/docs/**",
    "src/routes/**",
    "src/shared/shared.js",
    "src/emulator/core/**",
    "src/emulator/webview/**",
    "tests/**",
    "sandbox/**",
    "src/maps/dist/**"
  ],
  "ignoreDependencies": [
    "playwright"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn"
  }
}
