{
    "//": "Emit config for the src/simulation/ TypeScript simulation. The root tsconfig.json is typecheck-only (noEmit); this one builds src/simulation/*.ts to CommonJS so src/simulation/index.js can require it. Run via `npm run build:simulation`.",
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": [
            "ES2020"
        ],
        "types": [
            "node"
        ],
        "strict": true,
        "declaration": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": "src/simulation/dist",
        "rootDir": "src/simulation",
        "resolveJsonModule": true
    },
    "include": [
        "src/simulation/**/*.ts"
    ],
    "exclude": [
        "src/simulation/dist"
    ]
}
