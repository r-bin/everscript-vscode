tmp/
sandbox/**
call-log/**
script_parser/**
experimental/**

**/.git/**
**/.vscode/**
**/node_modules/**

# source maps
**/*.map

# test files
tests/**
**/test/**
**/__tests__/**
**/tests/**/*.test.evs

# NOTE: src/** must NOT be ignored — `main` is ./src/extension.js and the
# extension is loaded from source (there is no whole-repo build step).
# Only the TypeScript *sources* under src/maps are excluded; their compiled
# output in src/maps/dist/ is what ships and is required at runtime.
src/maps/*.ts

# Emulator cores: ship only the built artifacts (snes9x_2005.js/.wasm), not the
# C sources, build scripts, docs or submodule git pointers that surround them.
**/.git
**/.git/**
src/emulator/core/**/source/**
src/emulator/core/**/doc/**
src/emulator/core/**/libretro/**
src/emulator/core/**/*.sh
src/emulator/core/**/*.c
src/emulator/core/**/*.h
src/emulator/core/**/Makefile*
src/emulator/core/**/gitignore.txt
src/music/engine/*.c
src/music/engine/*.sh
# NOTE: copyright notices must be bundled alongside built .wasm/.js artifacts
# (src/music/engine/copyright and NOTICE.md ship with spc-engine.js)

# build artifacts that should not be included
out/**
scripts/**
build-cache/**
*.log
*.vsix
