tmp/

**/.git/**
**/.vscode/**
**/node_modules/**

# source maps
**/*.map

# test files
tests/**
**/test/**
**/__tests__/**
**/tests/**/*.test.evs

# NOTE: src/** must NOT be ignored. `main` is ./bundle/extension.js (tools/bundle.mts, built by
# `npm run package`), but the code still reads files next to its source at runtime (webview pages,
# knowledge entries, cores, JSON tables). `npm run package` uses bundle/.vscodeignore: this file plus the
# JS the bundle holds (tests/memory/package-files.test.js checks nothing read from disk is left out).
# TypeScript sources are excluded.
src/**/*.ts

# Emulator cores: ship only the built artifacts (snes9x_2005.js/.wasm), not the
# C sources, build scripts, docs or submodule git pointers that surround them.
**/.git
**/.git/**
src/core/emulator/core/**/source/**
src/core/emulator/core/**/doc/**
src/core/emulator/core/**/libretro/**
src/core/emulator/core/**/*.sh
src/core/emulator/core/**/*.c
src/core/emulator/core/**/*.h
src/core/emulator/core/**/Makefile*
src/core/emulator/core/**/gitignore.txt
src/games/evermore/music/engine/*.c
src/games/evermore/music/engine/*.sh
# NOTE: copyright notices must be bundled alongside built .wasm/.js artifacts
# (src/games/evermore/music/engine/copyright and NOTICE.md ship with spc-engine.js)

# build artifacts that should not be included
out/**
scripts/**
build-cache/**
*.log
*.vsix

# Claude Code wiring (symlinks to .agents/agents and .agents/skills)
.claude/**

# Not part of the extension (docs/cleanup.md 1.4)
.emscripten_cache/**
docs/**
wiki/**
.agents/**
tools/**
recorder/**
AGENTS.md
**/AGENTS.md
AI_ARCHITECTURE_GUIDE.md
**/*.d.ts
**/*.d.ts.map

# Legal guard: game data never ships
**/*.smc
**/*.sfc
**/*.srm
**/*.spc
**/*.state
**/*.sav
**/*.ips
**/*.bps

# The bundle's module list (tools/bundle.mts), for trimming the package later; not needed at runtime.
bundle/inputs.json
