  "enums": {"//":"Enums of ours, where the compiler has none (or one short of values): `base` adds the compiler enum's values; `flags`: a value is its named bits joined with |. Names say what the handler does with the value.","OBJECT_STATE":{"flags":true,"what":"an object's target state ($90:A36D, docs/map-format/map_objects.md §4c)","values":{"0x7e":"LAST","0x7f":"LAST_7F","0x8000":"INSTANT"}},"SPAWN_FLAGS":{"base":"FLAG_ENEMY","flags":true,"what":"spawn's word: the entity's +$10 bits (docs/entities/entities-reference.md), bit 15 a spawner record (knowledge opcodes/3c)","values":{"0x0010":"NEVER_SLEEPS","0x8000":"SPAWNER"}},"ROOM_HOOK":{"what":"attach_script's target below $2000: a room hook ($0EA2/$0EAC + 2(n-1), knowledge opcodes/3f), not an entity. Hook 1 is the drop hook ($90:857B); hook 5 is the Wings hook ($0EB4, e.g. BBM_WINGS); 2-4: room hooks ($0EAE, $0EB0, $0EB2)","values":{"0x01":"DROP_HOOK","0x02":"ROOM_HOOK_2","0x03":"ROOM_HOOK_3","0x04":"ROOM_HOOK_4","0x05":"WINGS_HOOK"}},"SCRIPT_TRIGGER":{"base":"SCRIPT_TRIGGER","flags":true,"what":"event trigger mask (knowledge opcodes/3f)","values":{"0x0001":"ROOM_HOOK"}},"OBJ_PALETTE":{"what":"OBJ sprite palette CGRAM offset","values":{"0x00":"PALETTE_0","0x20":"PALETTE_1","0x40":"PALETTE_2","0x60":"PALETTE_3","0x80":"PALETTE_4","0xa0":"PALETTE_5","0xc0":"PALETTE_6","0xe0":"PALETTE_7"}}}
