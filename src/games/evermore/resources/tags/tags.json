{
  "//": "soe://tags/ — hand-authored tags. Spec: docs/soe-tags-spec.md §5. Addresses are precompiled: base + offset from the everscript enums (in/core/.../03_sprites.evs: ATTRIBUTE._BOY = 0x4E89, _DOG = 0x4F37 entity records; ATTRIBUTE_GENERAL.POINTER_BOY = 0x0a26, POINTER_DOG = 0x0a70 stats blocks). The plugin never reads those files; `source` only says where a value was worked out.",

  "character": {
    "title": "Any entity on screen: boy, dog, enemy, NPC",
    "links": [{ "uri": "soe://rom/assets/characters/index.md", "role": "character records in the ROM" }],
    "sub": {
      "hp":             { "title": "Current HP" },
      "max_hp":         { "title": "Max HP" },
      "x":              { "title": "X position (pixels)" },
      "y":              { "title": "Y position (pixels)" },
      "z":              { "title": "Z height" },
      "z_level":        { "title": "Floor level (stairs, bridges), masked with 0x0030" },
      "velocity":       { "title": "Velocity" },
      "face_direction": { "title": "Facing direction (enum FACE_DIRECTION)" },
      "palette":        { "title": "Palette slot offset" },
      "stamina":        { "title": "Stamina / attack charge state (enum STAMINA)" },
      "status_1":       { "title": "Status effect #1 id" },
      "damage_source":  { "title": "Entity that caused the most recent damage" },
      "last_damage":    { "title": "Last damage taken" }
    }
  },

  "player": {
    "title": "A character the player controls",
    "parents": ["character"],
    "sub": {
      "name":          { "title": "Name pointer" },
      "attack":        { "title": "Attack" },
      "defense":       { "title": "Defense" },
      "magic_defense": { "title": "Magic defense" },
      "evade":         { "title": "Evade %" },
      "hit":           { "title": "Hit %" },
      "xp":            { "title": "Experience" },
      "xp_required":   { "title": "XP needed for the next level" },
      "level":         { "title": "Level" },
      "charge_max":    { "title": "Max charge-up" },
      "charge_rate":   { "title": "Charge-up rate" },
      "boost_attack":  { "title": "Status boost: attack" },
      "boost_defend":  { "title": "Status boost: defense" },
      "boost_evade":   { "title": "Status boost: evade" },
      "boost_hit":     { "title": "Status boost: hit" },
      "entity":        { "title": "Entity record (all character attributes)" },
      "stats":         { "title": "Stats block (equipment-adjusted stats)" }
    }
  },

