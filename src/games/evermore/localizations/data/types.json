{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SNES WRAM Types Definition",
  "typedefs": {
    "entity": {
      "type": "u16",
      "desc": "16-bit WRAM pointer to an active EntityRecord (e.g. $7E3DE5..$7E4FE4)"
    },
    "JoypadButtons": {
      "type": "u16",
      "desc": "16-bit SNES controller button bitmask (B, Y, Select, Start, D-Pad, A, X, L, R)"
    }
  },
  "enums": {
    "EntityState": {
      "0x00": "INACTIVE",
      "0x01": "SPAWNING",
      "0x02": "ACTIVE",
      "0x03": "DYING"
    },
    "Direction": {
      "0x00": "UP",
      "0x02": "RIGHT",
      "0x04": "DOWN",
      "0x06": "LEFT"
    },
    "DogType": {
      "size": 1,
      "values": {
        "0x00": "WOLF",
        "0x01": "GREYHOUND",
        "0x02": "POODLE",
        "0x03": "TOASTER"
      }
    },
    "DogAiCommand": {
      "size": 1,
      "values": {
        "0x00": "FOLLOW",
        "0x01": "HEEL",
        "0x02": "SNIFF",
        "0x03": "ATTACK"
      }
    },
    "WeaponClass": {
      "0x00": "SWORD",
      "0x02": "AXE",
      "0x04": "SPEAR",
      "0x06": "BAZOOKA"
