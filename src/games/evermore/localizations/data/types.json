    "WindowState": {
      "size": 2,
      "values": {
        "0x00": "CLOSED",
        "0x01": "OPENING",
        "0x02": "OPEN",
        "0x03": "CLOSING"
      }
    },
    "ChoiceBoxState": {
      "size": 2,
