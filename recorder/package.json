{
  "name": "snes-cdl-recorder",
  "displayName": "SNES CDL Recorder",
  "description": "Play your own SNES ROM and record which bytes run as code, which are read as data, and the inputs that got there. Share the recording as one zip (no ROM bytes).",
  "version": "0.0.0",
  "publisher": "rbin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rbin/everscript-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/recorder/extension.js",
  "activationEvents": [
    "onCommand:cdlRecorder.openEmulator",
    "onCommand:cdlRecorder.openRom",
    "onCommand:cdlRecorder.exportBundle",
    "onCommand:cdlRecorder.openDataFolder"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cdlRecorder.openEmulator",
        "title": "Open Emulator",
        "category": "CDL Recorder"
      },
      {
        "command": "cdlRecorder.openRom",
        "title": "Open ROM...",
        "category": "CDL Recorder"
      },
      {
        "command": "cdlRecorder.exportBundle",
        "title": "Export Recording Bundle",
        "category": "CDL Recorder"
      },
      {
        "command": "cdlRecorder.openDataFolder",
        "title": "Open Data Folder",
        "category": "CDL Recorder"
      }
    ]
  }
}
