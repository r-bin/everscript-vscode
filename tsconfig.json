{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020"],
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": [
        "extension.js",
        "settings-model.js",
        "code_highlighter/**/*.js",
        "memory_radar/**/*.js",
        "debugger/**/*.js"
    ],
    "exclude": [
        "node_modules",
        "tmp",
        "dependencies",
        "tools",
        "emulator"
    ]
}
