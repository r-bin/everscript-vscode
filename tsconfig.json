{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020"],
        "types": ["node", "vscode"],
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*.js",
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "tmp",
        "dependencies",
        "tools",
        "src/core/emulator/core",
        "src/games/evermore/memory/webview",
        "src/games/evermore/scaling/webview",
        "src/games/evermore/rooms/webview",
        "src/games/evermore/docs-tab",
        "src/core/emulator/webview",
        "src/games/evermore/sprites/webview",
        "tests"
    ]
}
