{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020"],
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*.js",
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "tmp",
        "dependencies",
        "tools",
        "src/emulator/core",
        "src/memory/webview",
        "src/scaling/webview",
        "src/rooms/webview",
        "src/docs",
        "src/routes",
        "src/emulator/webview",
        "sandbox",
        "tests"
    ]
}
