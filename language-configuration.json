{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "{",  "close": "}"  },
    { "open": "(",  "close": ")"  },
    { "open": "[",  "close": "]"  },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'",  "close": "'",  "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "\\{[^}]*$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*|0[xX][0-9a-fA-F]+|0[dD][0-9]+"
}
