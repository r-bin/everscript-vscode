// Generate reconstructed-c/include/soe_ram.h from the WRAM knowledge entries (knowledge/ram/*.md): one name per
// address, shared by every C file. Names come only from the entries; to name an address for C, write its entry
// (game-knowledge skill) and rerun this. --check exits 1 when the header is out of date (for the test tier).
//   node tools/c-to-rom/gen-ram-header.mts [--check]
import { readFileSync, writeFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { createRequire } from 'node:module';
import { REPO } from './emu.mts';

const require = createRequire(import.meta.url);
export const RAM_HEADER = join(REPO, 'reconstructed-c/include/soe_ram.h');

interface Entry { addr: number; end: number; kind: string | null; name: string | null; title: string; body: string; file: string }

const ident = (s: string) => s.replace(/[^A-Za-z0-9_]/g, '_').toUpperCase();
const h = (v: number, n = 4) => '0x' + v.toString(16).toUpperCase().padStart(n, '0');

/** Field rows of a "| +$1A (...) | 2 | POS_X | meaning |" table in an entry's body. */
function fields(body: string): { off: number; size: number; name: string }[] {
    const out: { off: number; size: number; name: string }[] = [];
    for (const m of body.matchAll(/^\|\s*\+\$([0-9A-Fa-f]+)[^|]*\|\s*(\d+)\s*\|\s*([A-Za-z_][A-Za-z0-9_]*)\s*\|/gm))
        out.push({ off: parseInt(m[1], 16), size: Number(m[2]), name: ident(m[3]) });
    return out;
}

export function ramHeader(list: Entry[]): string {
    const lines = [
        '/*',
        ' * soe_ram.h: WRAM by name. GENERATED by tools/c-to-rom/gen-ram-header.mts from',
        ' * src/games/evermore/localizations/knowledge/ram/*.md. Do not edit: write or fix the entry and rerun.',
        ' *',
        ' * <NAME>_ADDR is the WRAM offset (0x00000-0x1FFFF from $7E:0000), <NAME>_SIZE its byte count;',
        ' * 1- and 2-byte entries also get an accessor <NAME>. Record fields: <NAME>_<FIELD>_OFF.',
        ' */',
        '#ifndef SOE_RAM_H',
        '#define SOE_RAM_H',
        '',
        '#include "soe.h"',
        '',
    ];
    const used = new Set<string>();
    for (const e of list) {
        if (!e.name || e.addr < 0x7E0000 || e.addr > 0x7FFFFF) continue;
        const name = ident(e.name);
        if (used.has(name)) throw new Error(`${e.file}: name ${name} is used twice`);
        used.add(name);
        const off = e.addr - 0x7E0000, size = e.end - e.addr + 1;
        lines.push(`/* ${e.title} ($${e.addr.toString(16).toUpperCase()}${size > 1 ? '-$' + e.end.toString(16).toUpperCase() : ''}, ${e.kind || '?'}): ${e.file} */`);
        lines.push(`#define ${name}_ADDR ${h(off, off > 0xFFFF ? 5 : 4)}u`, `#define ${name}_SIZE ${size}`);
        if (size === 1) lines.push(`#define ${name} RAM8(${name}_ADDR)`);
        if (size === 2) lines.push(`#define ${name} RAM16(${name}_ADDR)`);
        const seen = new Set<string>();
        for (const f of fields(e.body)) {
            const key = `${name}_${f.name}_OFF`;
            if (seen.has(key)) continue;
            seen.add(key);
            lines.push(`#define ${key} 0x${f.off.toString(16).toUpperCase().padStart(2, '0')}u   /* ${f.size} byte${f.size > 1 ? 's' : ''} */`);
        }
        lines.push('');
    }
    lines.push('#endif /* SOE_RAM_H */');
    return lines.join('\n') + '\n';
}

if (import.meta.url === `file://${process.argv[1]}`) {
    const { entries } = require('../../dist/games/evermore/localizations/knowledge');
    const text = ramHeader(entries('ram'));
    if (process.argv.includes('--check')) {
        const ok = existsSync(RAM_HEADER) && readFileSync(RAM_HEADER, 'utf8') === text;
        console.log(ok ? 'soe_ram.h is up to date' : 'soe_ram.h is out of date: run node tools/c-to-rom/gen-ram-header.mts');
        process.exit(ok ? 0 : 1);
    }
    writeFileSync(RAM_HEADER, text);
    console.log(`wrote ${RAM_HEADER}`);
}
