// Table hack test: enemy 0x8F, the first id past vanilla's 143, built by
// `tools/table-hack/build.js --add-enemy 113 --recolor-room 0x15` (a Mosquito copy with its own red/blue-swapped
// sprite palette in bank $FA, and Brian's room on a recoloured copy of its first tile family). Brian's room shows the
// new enemy next to a vanilla Mosquito (0x0F) on the new map palette.
#memory(
    function_key(0x0000)..function_key(0x1716), // script pointer slots the compiler may reuse
    0x320000..0x32ffff,                         // $F2: scripts in the upper half
    <0x2272>..<0x2558>,
    <0x2834>..<0x28ff>
)
#include("in/core")

@install(ADDRESS.INTRO_FIRST_CODE_EXECUTED)
fun intro_skip() {
    map_transition(brians_room, center, NONE);
}

map brians_room(MAP.BRIAN) {
    enum entrance {
        center = entrance(0x17, 0d40, NONE)
    }

    fun trigger_enter() {
        add_enemy(ENEMY.MOSQUITO, 0x13, 0d36);
        add_enemy(0x8f, 0x1b, 0d36);

        fade_in();
    }
};
