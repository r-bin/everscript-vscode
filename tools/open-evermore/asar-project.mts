// Standalone Asar project generator (docs/open-evermore/code.md §3.1, docs/todo/open-evermore-code.md C0a):
// turns a built Open Evermore layout into `main.asm`, `enums.asm`, `wram.asm`, `symbols.asm`, and `blobs/` so Asar
// can assemble the whole cartridge image from the tree's `code/*.asm` and encoded assets.
import { spawnSync } from 'node:child_process';
import { existsSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import type { Base } from './base.mts';
import type { Codec, ImplodeContext, Item, Span, Write } from './codec.mts';
import { normalise, piecesOf } from './layout.mts';
import type { Plan } from './layouts.mts';
import { text } from './tree.mts';
import type { Tree } from './tree.mts';

const FOUR_MIB = 0x400000;
const ROM_SIZE_OFFSET = 0xFFD7;
const hex = (v: number, width: number) => v.toString(16).toUpperCase().padStart(width, '0');
const sanitize = (s: string) => s.replace(/[^A-Za-z0-9_]+/g, '_');

/** Asar symbol name for a placed resource or generated table key (`<kind>/<name>`). */
export function resourceSymbol(key: string): string {
    const slash = key.indexOf('/');
    const kind = slash < 0 ? 'res' : key.slice(0, slash);
    const rest = slash < 0 ? key : key.slice(slash + 1);
    if (rest.startsWith('_')) return `tbl_${sanitize(kind)}_${sanitize(rest.slice(1))}`;
    return `res_${sanitize(kind)}_${sanitize(rest)}`;
}

/** Asar `!NAME = value` defines for every enum (`<KIND>_COUNT`, `<KIND>_<ITEM>`). */
export function enumDefines(ids: Map<string, Map<string, number>>): Map<string, number> {
    const out = new Map<string, number>();
    for (const [kind, map] of [...ids.entries()].sort((a, b) => a[0].localeCompare(b[0]))) {
        if (!map.size) continue;
        const prefix = sanitize(kind).toUpperCase();
        out.set(`${prefix}_COUNT`, Math.max(...map.values()) + 1);
        const byId = [...map.entries()].sort((a, b) => a[1] - b[1] || a[0].localeCompare(b[0]));
        for (const [name, id] of byId) {
            const sym = `${prefix}_${sanitize(name).toUpperCase()}`;
            out.set(out.has(sym) ? `${sym}_${id}` : sym, id);
        }
    }
    return out;
}

/** Hardware HiROM/ExHiROM bus address of a file offset `at` for `org` directives in Asar. */
function orgBus(at: number, layout: Plan['layout']): number {
    if (layout === 'exhirom' && at >= FOUR_MIB) return 0x400000 + (at - FOUR_MIB);
    return 0xC00000 + at;
}

export interface AsarBuildInput {
    base: Base;
    plan: Plan;
    kinds: Codec[];
    ctx: ImplodeContext;
    items: Item[];
    placed: Map<string, number>;
    writes: Write[];
    codeFiles: Map<string, string>;
}

/** Builds the complete standalone Asar project (paths relative to `_build/asar/`). */
export function buildAsarProject(input: AsarBuildInput): Tree {
    const { base, plan, kinds, ctx, items, placed, writes, codeFiles } = input;
    const files: Tree = new Map();

    // 1. enums.asm: enum counts/ids plus codec-exported constants (WRAM types/structs/enums).
    const defines = enumDefines(ctx.ids);
    const wramLabels = new Map<string, number>();
    for (const codec of kinds) {
        const d = codec.defines?.(ctx);
        if (!d) continue;
        for (const [k, v] of d.defines) if (!defines.has(k)) defines.set(k, v);
        for (const [k, v] of d.labels) if (!wramLabels.has(k)) wramLabels.set(k, v);
    }
    const enumLines = ['; Generated by Open Evermore implode — enum IDs, counts, and WRAM types'];
    for (const [k, v] of defines) enumLines.push(`!${k} = $${hex(v, v > 0xFFFF ? 6 : v > 0xFF ? 4 : 2)}`);
    files.set('enums.asm', text(enumLines.join('\n') + '\n'));

    // 2. wram.asm: WRAM variables at their placed bus addresses.
    const wramLines = ['; Generated by Open Evermore implode — WRAM variable addresses'];
    for (const [k, v] of [...wramLabels.entries()].sort((a, b) => a[1] - b[1] || a[0].localeCompare(b[0]))) {
        wramLines.push(`${k} = $${hex(v, 6)}`);
    }
    files.set('wram.asm', text(wramLines.join('\n') + '\n'));

    // 3. symbols.asm: placed non-code resources and generated tables.
    const symMap = new Map<string, number>();
    for (const [key, at] of placed) {
        if (key.startsWith('code/') || key.startsWith('wram/')) continue;
        const sym = resourceSymbol(key);
        if (!symMap.has(sym)) symMap.set(sym, plan.pointer(at));
    }
    for (const [key, at] of ctx.symbols) {
        if (key.startsWith('code/') || key.startsWith('wram/') || key.includes('/__')) continue;
        const sym = resourceSymbol(key);
        if (!symMap.has(sym)) symMap.set(sym, plan.pointer(at));
    }
    const symLines = ['; Generated by Open Evermore implode — placed asset and table addresses'];
    for (const [sym, bus] of [...symMap.entries()].sort((a, b) => a[0].localeCompare(b[0]))) {
        symLines.push(`${sym} = $${hex(bus, 6)}`);
    }
    files.set('symbols.asm', text(symLines.join('\n') + '\n'));

    // 4. blobs/base.bin: base unexploded image with past-end mirrors.
    const baseBuf = new Uint8Array(plan.content).fill(0xFF);
    baseBuf.set(base.image);
    plan.prepare(baseBuf, base.image.length);
    files.set('blobs/base.bin', baseBuf);

    // 5. Build non-code content buffer and collect per-kind contiguous spans + post-code patches.
    const nonCode = baseBuf.slice();
    const codeSpans: Span[] = [];
    const nonCodeItemsByKind = new Map<string, Span[]>();
    for (const item of items) {
        const at = placed.get(item.key);
        if (at === undefined) continue;
        if (item.key.startsWith('code/')) {
            codeSpans.push({ start: at, end: at + item.bytes.length });
            continue;
        }
        const kind = item.key.split('/')[0];
        const list = nonCodeItemsByKind.get(kind) ?? [];
        for (const p of piecesOf(item, at)) {
            nonCode.set(item.bytes.subarray(p.offset, p.offset + p.end - p.start), p.start);
            list.push({ start: p.start, end: p.end });
        }
        nonCodeItemsByKind.set(kind, list);
    }
    const normCode = normalise(codeSpans);
    const overlapsCode = (at: number, len: number) => normCode.some(c => at < c.end && at + len > c.start);
    const patchSpans: Span[] = [];
    for (const w of writes) {
        if (w.file.startsWith('code/')) continue;
        nonCode.set(w.bytes, w.at);
        const span = { start: w.at, end: w.at + w.bytes.length };
        if (overlapsCode(w.at, w.bytes.length)) { patchSpans.push(span); continue; }
        const kind = w.file.split('/')[0];
        const list = nonCodeItemsByKind.get(kind) ?? [];
        list.push(span);
        nonCodeItemsByKind.set(kind, list);
    }

    const incbinLines: string[] = [];
    for (const [kind, spans] of [...nonCodeItemsByKind.entries()].sort((a, b) => a[0].localeCompare(b[0]))) {
        const merged = normalise(spans);
        if (!merged.length) continue;
        const total = merged.reduce((s, x) => s + (x.end - x.start), 0);
        const blob = new Uint8Array(total);
        let pos = 0;
        for (const s of merged) {
            const len = s.end - s.start;
            blob.set(nonCode.subarray(s.start, s.end), pos);
            incbinLines.push(`org $${hex(orgBus(s.start, plan.layout), 6)} : incbin "blobs/${kind}.bin":${hex(pos, 1)}-${hex(pos + len, 1)}`);
            pos += len;
        }
        files.set(`blobs/${kind}.bin`, blob);
    }

    const postCodeLines: string[] = [];
    const mergedPatches = normalise(patchSpans);
    if (mergedPatches.length) {
        const total = mergedPatches.reduce((s, x) => s + (x.end - x.start), 0);
        const blob = new Uint8Array(total);
        let pos = 0;
        for (const s of mergedPatches) {
            const len = s.end - s.start;
            blob.set(nonCode.subarray(s.start, s.end), pos);
            postCodeLines.push(`org $${hex(orgBus(s.start, plan.layout), 6)} : incbin "blobs/patches.bin":${hex(pos, 1)}-${hex(pos + len, 1)}`);
            pos += len;
        }
        files.set('blobs/patches.bin', blob);
    }

    // 6. Code routines, sorted by placed address.
    const codeLines: string[] = [];
    const codeEntries = [...codeFiles.entries()]
        .map(([name, path]) => ({ name, path, at: placed.get(`code/${name}`) }))
        .filter((e): e is { name: string; path: string; at: number } => e.at !== undefined)
        .sort((a, b) => a.at - b.at);
    for (const e of codeEntries) {
        codeLines.push(`org $${hex(plan.pointer(e.at), 6)}`, `incsrc "../../${e.path}"`);
    }

    // 7. main.asm
    const baseLines: string[] = [];
    for (let off = 0; off < plan.content; off += 0x10000) {
        const end = Math.min(off + 0x10000, plan.content);
        baseLines.push(`org $${hex(orgBus(off, plan.layout), 6)} : incbin "blobs/base.bin":${hex(off, 1)}-${hex(end, 1)}`);
    }
    const main: string[] = [
        `; Generated by Open Evermore implode (${plan.label})`,
        plan.layout === 'sa1' ? '; Note: builds the 4 MiB HiROM content image; run tools/sa1/convert.mts for SA-1.' : '',
        plan.layout === 'exhirom' ? 'exhirom' : 'hirom',
        '',
        'incsrc "enums.asm"',
        'incsrc "wram.asm"',
        'incsrc "symbols.asm"',
        '',
        '; Base unexploded ROM',
        ...baseLines,
    ].filter(l => l !== undefined);
    if (incbinLines.length) main.push('', '; Exploded assets and tables', ...incbinLines);
    if (codeLines.length) main.push('', '; Exploded 65C816 routines', ...codeLines);
    if (postCodeLines.length) main.push('', '; Non-symbolized patches inside code holes', ...postCodeLines);
    let romSize = base.image[ROM_SIZE_OFFSET];
    while (romSize > 0 && romSize < 0x10 && (1024 << romSize) < plan.content) romSize++;
    if (romSize !== base.image[ROM_SIZE_OFFSET]) {
        main.push('', '; Grown ROM size header byte', `org $${hex(0xC00000 + ROM_SIZE_OFFSET, 6)} : db $${hex(romSize, 2)}`);
    }
    files.set('main.asm', text(main.join('\n') + '\n'));
    return files;
}

const REPO = resolve(dirname(new URL(import.meta.url).pathname), '..', '..');

/** Finds an Asar binary from explicit path, `ASAR` env, PATH, or sibling `../asar`. */
export function findAsar(explicit?: string): string | null {
    if (explicit && existsSync(explicit)) return explicit;
    if (process.env.ASAR && existsSync(process.env.ASAR)) return process.env.ASAR;
    const w = spawnSync('which', ['asar'], { encoding: 'utf8' });
    if (w.status === 0 && w.stdout.trim()) return w.stdout.trim();
    const sibling = resolve(REPO, '../asar/asar/bin/asar');
    return existsSync(sibling) ? sibling : null;
}

/** Runs Asar on `<asarDir>/main.asm` to produce `outRom`. */
export function assembleWithAsar(asarDir: string, outRom: string, asarBin?: string): { ok: boolean; error?: string; image?: Uint8Array } {
    const bin = findAsar(asarBin);
    if (!bin) return { ok: false, error: 'asar binary not found (set ASAR or pass --asar)' };
    mkdirSync(dirname(outRom), { recursive: true });
    rmSync(outRom, { force: true });
    const res = spawnSync(bin, ['main.asm', outRom], { cwd: asarDir, encoding: 'utf8' });
    if (res.status !== 0 || !existsSync(outRom)) {
        return { ok: false, error: (res.stderr || res.stdout || `asar exited ${res.status}`).trim() };
    }
    return { ok: true, image: new Uint8Array(readFileSync(outRom)) };
}
