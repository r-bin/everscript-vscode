{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020"],
        "types": ["node"],
        "strict": true,
        "declaration": true,
        "rootDir": "src",
        "outDir": "dist",
        "skipLibCheck": true,
        "esModuleInterop": true
    },
    "include": ["src/platform/**/*.ts", "src/games/**/*.ts"]
}
