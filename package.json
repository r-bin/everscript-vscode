{
  "name": "everscript",
  "displayName": "Everscript",
  "description": "Syntax highlighting for Everscript (.evs) — the Secret of Evermore ROM scripting language",
  "version": "0.1.1",
  "publisher": "rbin",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "test": "vscode-tmgrammar-test -g syntaxes/everscript.tmLanguage.json 'test/**/*.test.evs'"
  },
  "devDependencies": {
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "contributes": {
    "languages": [
      {
        "id": "everscript",
        "aliases": ["Everscript", "evs"],
        "extensions": [".evs"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "everscript",
        "scopeName": "source.evs",
        "path": "./syntaxes/everscript.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Everscript Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/everscript-dark.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rbin/everscript-vscode"
  },
  "license": "MIT"
}
