{
  "name": "everscript",
  "displayName": "Everscript",
  "description": "Syntax highlighting, hover docs, and completions for Everscript (.evs) \u2014 the Secret of Evermore ROM scripting language",
  "version": "0.2.12",
  "publisher": "rbin",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:everscript"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "scripts": {
    "test": "vscode-tmgrammar-test -g syntaxes/everscript.tmLanguage.json 'test/**/*.test.evs' && node test/radar.test.js"
  },
  "devDependencies": {
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "contributes": {
    "languages": [
      {
        "id": "everscript",
        "aliases": [
          "Everscript",
          "evs"
        ],
        "extensions": [
          ".evs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "everscript",
        "scopeName": "source.evs",
        "path": "./syntaxes/everscript.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Everscript Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/everscript-dark.json"
      }
    ],
    "snippets": [
      {
        "language": "everscript",
        "path": "./snippets/everscript.json"
      }
    ],
    "problemMatchers": [
      {
        "name": "everscript",
        "owner": "everscript",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+):(\\d+):\\s+(error|warning|note):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "everscript",
        "required": [
          "script"
        ],
        "properties": {
          "script": {
            "type": "string",
            "description": "Path to the root .evs file to compile"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "everscript.openMemoryRadar",
        "title": "Everscript: Open Memory Radar"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == everscript",
          "command": "everscript.openMemoryRadar",
          "group": "navigation@30"
        }
      ]
    },
    "configuration": {
      "title": "Everscript",
      "properties": {
        "everscript.inDirectory": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `in/` directory containing `.evs` source files. Used for static analysis (scope detection, room tree, `#include` resolution). Defaults to `<workspace>/in`."
        },
        "everscript.patchesDirectory": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `patches/` directory. Used to detect active patches (e.g. `scale_enemies`). Defaults to `<workspace>/patches`."
        },
        "everscript.romPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Secret of Evermore ROM (`.smc`, no header). Required for the Scaling tab (character stats) and ROM trigger offsets. Defaults to `<workspace>/Secret of Evermore (U) [!].smc`."
        },
        "everscript.assetsPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the assets directory. Should contain an `ingredients/` subfolder with `.webp` ingredient icons. Defaults to the bundled extension assets."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rbin/everscript-vscode"
  },
  "license": "MIT"
}